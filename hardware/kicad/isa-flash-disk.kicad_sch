	(text "ISA Flash Disk rev A - UNTESTED DESIGN, NOT FOR PRODUCTION\nDefaults: window CC000h (SW1: 1=SA13 ON, 2=SA14 OFF, 3=SA15 OFF, 4=SA16 ON, 5=SA17 ON)\n          ports 2A0h (SW2: 1=SA3 ON, 2=SA4 ON, 3=SA5 OFF, 4=SA6 ON, 5=SA7 OFF, 6=SA8 ON)\nSwitch ON = 0, OFF = 1. SA19 = SA18 = 1 and SA9 = 1 are fixed; AEN must be 0 for ports.\nBANK (base+0): bits 6..0 = flash A19..A13, bit 7 = chip (0 = U1, 1 = U2).\nCTRL (base+1): bit 0 = WE_EN, bit 1 = VPP_EN. Both registers clear on RESET DRV.\nJP1 WRITE is NOT fitted by default: without it VPP < 6.5 V and the flash cannot be altered.\nSee docs/architecture.md and docs/memory-map.md."
		(exclude_from_sim no)
		(at 20.32 368.3 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "a0b41480-c681-5d69-aacc-ba76b449a818")
	)
	(text "ISA edge: symbol pins 1..31 = B1..B31, 32..62 = A1..A31 (IBM XT Technical Reference 1-17, 1-18).\nB8 (XT -CARD SLCTD / AT 0WS) is not connected: do not use slot J8 of an IBM 5160."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4757393d-9ac7-5b9d-821d-55e4bd58aa86")
	)
